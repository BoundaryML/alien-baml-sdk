{
  "id": "platform.bootstrapCommands.unavailable_503",
  "phase": 1,
  "notes": "A 503 API error keeps the server's code and retryable flag.",
  "rule": "command_registry_unavailable.rs",
  "call": {
    "fn": "platform.bootstrapCommands",
    "args": {
      "client": {
        "base_url": "${stub.base}",
        "api_key": "${secrets.apiKey}",
        "workspace": "my-workspace"
      },
      "request": {
        "deploymentId": "dep_0c29fq4a2yjb7kx3smwdgxlcmpqr",
        "role": "sender"
      }
    }
  },
  "exchanges": [
    {
      "expect": {
        "method": "POST",
        "path": "/v1/commands/bootstrap"
      },
      "respond": {
        "status": 503,
        "json": {
          "code": "SERVICE_UNAVAILABLE",
          "message": "The API cannot serve the request right now.",
          "internal": false,
          "retryable": true,
          "httpStatusCode": 503,
          "requestId": "00000000-0000-4000-8000-000000000000"
        }
      }
    }
  ],
  "expect_result": null,
  "expect_error": {
    "code": "SERVICE_UNAVAILABLE",
    "retryable": true,
    "http_status": 503
  },
  "assert": []
}
