{
  "open_enums": "all",
  "open_unions": true,
  "coverage": "docs/importer-coverage.md",
  "services": [
    {
      "name": "platform",
      "spec": "specs/platform/openapi.json",
      "overlays": [
        "specs/platform/sdk-compatibility-overlay.json"
      ],
      "operations": [
        "bootstrapCommands",
        "cancelDeploymentVolumeRestore",
        "configureProjectBuckets",
        "configureProjectDeployments",
        "configureProjectKeys",
        "configureProjectModels",
        "configureProjectRegistry",
        "configureProjectRemoteSandbox",
        "createAPIKey",
        "createAccessRequest",
        "createDeployment",
        "createDeploymentGroup",
        "createDeploymentGroupToken",
        "createDeploymentToken",
        "createDeploymentVolumeRestore",
        "createManager",
        "createProject",
        "createRelease",
        "createReleaseChannel",
        "createRemoteBindingsExternalAccess",
        "createSetupLink",
        "createSetupRegistrationOperation",
        "createWorkspace",
        "deleteDeployment",
        "deleteManager",
        "deleteProject",
        "deleteReleaseChannel",
        "ensureDeploymentGroupByExternalId",
        "ensureProjectSandboxBaseImageRepository",
        "generateManagerBindingToken",
        "generateManagerToken",
        "getAPIKey",
        "getAccessRequest",
        "getAccessRequestCoordinates",
        "getCommand",
        "getDeployment",
        "getDeploymentGroup",
        "getDeploymentGroupByExternalId",
        "getDeploymentInfo",
        "getDeploymentUpdateOperation",
        "getManager",
        "getProject",
        "getProjectCapabilityOverview",
        "getProjectDeploymentLinkSetup",
        "getProjectTemplateUrls",
        "getRelease",
        "getResourceDeploymentDetail",
        "getSetupRegistrationOperation",
        "invokeOperation",
        "listAPIKeys",
        "listDeploymentGroups",
        "listDeploymentMachines",
        "listDeploymentVolumeRestores",
        "listDeployments",
        "listEvents",
        "listManagerEvents",
        "listManagers",
        "listMemberships",
        "listProjects",
        "listReleaseChannels",
        "listReleases",
        "moveDeployment",
        "pinDeploymentRelease",
        "planDeploymentCompute",
        "prepareDeploymentStack",
        "promoteRelease",
        "redeployDeployment",
        "resolve",
        "retryDeployment",
        "retryManagerSetup",
        "revokeAPIKey",
        "revokeAccessRequest",
        "setDeploymentGroupExternalId",
        "setDeploymentReleaseChannel",
        "verifyOperationCheck",
        "whoami"
      ],
      "out": "baml/baml_src/ns_platform",
      "client": "platform",
      "naming": "speakeasy-group",
      "workspace_global": true,
      "method_renames": [
        {
          "method": "POST",
          "path": "/v1/deployment-groups/{id}/tokens",
          "name": "createToken"
        }
      ]
    },
    {
      "name": "manager",
      "spec": "specs/manager/openapi.json",
      "operations": [
        "create_command",
        "get_command_status"
      ],
      "out": "baml/baml_src/ns_manager",
      "client": "manager",
      "naming": "first-tag"
    }
  ]
}
