/// Create a customer setup link
///
/// Ensures the Deployment Group identified by Project and external ID, then creates a group-scoped setup link with exact captured sources.
///
/// `POST /v1/deployment-groups/setup-links` (operation `createSetupLink`).
function create(client: root.platform.PlatformClient, body: root.platform.CreateSetupLinkRequest) -> root.platform.CreateSetupLinkResponse throws root.errors.AlienError {
    root.internal.platform_json<root.platform.CreateSetupLinkResponse>(
        client, "POST", "/v1/deployment-groups/setup-links",
        query = { "workspace": client.workspace },
        body = root.internal.json_body(body),
    )
}
