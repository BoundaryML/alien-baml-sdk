/// Get the workspace billing entitlements used for product feature gates. Autumn is the source of truth; the response is served through the workspace billing read model with stale-cache fallback.
///
/// `GET /v1/billing/entitlements` (operation `getWorkspaceBillingEntitlements`).
function getEntitlements(client: root.platform.PlatformClient) -> root.platform.WorkspaceBillingEntitlements throws root.errors.AlienError {
    root.internal.platform_json<root.platform.WorkspaceBillingEntitlements>(
        client, "GET", "/v1/billing/entitlements",
        query = { "workspace": client.workspace },
    )
}

/// Refresh the workspace billing entitlements from Autumn now, for example right after checkout, instead of waiting for Autumn's billing webhook. Workspace admins only. Calls within a few seconds share one refresh.
///
/// `POST /v1/billing/sync` (operation `syncWorkspaceBilling`).
function sync(client: root.platform.PlatformClient) -> root.platform.WorkspaceBillingEntitlements throws root.errors.AlienError {
    root.internal.platform_json<root.platform.WorkspaceBillingEntitlements>(
        client, "POST", "/v1/billing/sync",
        query = { "workspace": client.workspace },
    )
}
