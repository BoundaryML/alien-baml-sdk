/// Current deployment state (includes releases)
class DeploymentState {
    /// Release metadata
    ///
    /// Identifies a specific release version and includes the stack definition.
    /// The deployment engine uses this to track which release is currently deployed
    /// and which is the target.
    currentRelease: TargetDeploymentReleaseInfo?,
    environmentInfo: (CommandDeploymentInfoEnvironmentInfoAws | CommandDeploymentInfoEnvironmentInfoGcp | CommandDeploymentInfoEnvironmentInfoAzure | CommandDeploymentInfoEnvironmentInfoLocal | CommandDeploymentInfoEnvironmentInfoTest | CommandDeploymentInfoEnvironmentInfoOther)?,
    /// Canonical error container that provides a structured way to represent errors
    /// with rich metadata including error codes, human-readable messages, context,
    /// and chaining capabilities for error propagation.
    ///
    /// This struct is designed to be both machine-readable and user-friendly,
    /// supporting serialization for API responses and detailed error reporting
    /// in distributed systems.
    error: DeploymentError?,
    /// Represents the target cloud platform.
    ///
    /// Known values: `aws`, `gcp`, `azure`, `kubernetes`, `machines`, `local`, `test`. Others may appear.
    platform: string,
    /// Protocol version for cross-actor compatibility.
    /// All actors (manager, push client, agent) check this before stepping.
    /// Mismatched versions produce a clear error instead of silent corruption.
    /// See docs/02-manager/10-deployment-protocol.md.
    protocolVersion: int,
    /// Whether a retry has been requested for a failed deployment
    /// When true and status is a failed state, the deployment system will retry failed resources
    retryRequested: bool?,
    /// Runtime metadata for deployment
    ///
    /// Stores deployment state that needs to persist across step calls.
    runtimeMetadata: DeploymentRuntimeMetadata?,
    /// Represents the collective state of all resources in a stack, including platform and pending actions.
    stackState: DeploymentStackState?,
    /// Deployment status in the deployment lifecycle.
    ///
    /// For observe-only deployments with no release or stack state, `Running`
    /// means the Operator is attached. Connectivity comes from `lastHeartbeatAt`;
    /// resource health comes from inventory and resource heartbeat data.
    ///
    /// Known values: `pending`, `preflights-failed`, `initial-setup`, `initial-setup-failed`, `provisioning`, `waiting-for-machines`, `waiting-for-secrets`, `provisioning-failed`, `running`, `refresh-failed`, `update-pending`, `updating`, `update-failed`, `delete-pending`, `deleting`, `delete-failed`, `teardown-required`, `teardown-failed`, `retention-required`, `retained`, `deleted`, `error`. Others may appear.
    status: string,
    /// Release metadata
    ///
    /// Identifies a specific release version and includes the stack definition.
    /// The deployment engine uses this to track which release is currently deployed
    /// and which is the target.
    targetRelease: TargetDeploymentReleaseInfo?,

    @@json.omit_nulls
}

