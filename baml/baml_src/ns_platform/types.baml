    /// Display-only scope reported by the Operator manifest
    operatorScope: string?,
    /// Display-only permission tier reported by the Operator manifest
    operatorPermission: string?,
    /// Version reported by the Operator
    operatorVersion: string?,
    /// Capability state reported by the Operator
    capabilities: OperatorCapabilityReport[]?,
    /// Plugin bundle set hash the Operator reports having loaded
    observedOperationsBundleHash: string?,
    /// Operations the Operator reports as currently loaded
    observedOperations: ReportedOperation[]?,
    /// Whether a retry has been requested for a failed deployment
    retryRequested: bool,
    /// Timestamp of the last received heartbeat from the deployment
    lastHeartbeatAt: string?,
    /// Latest error information if the deployment is in a failed state
