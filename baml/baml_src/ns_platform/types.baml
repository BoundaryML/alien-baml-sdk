class VerifyOperationCheckRequest {
    /// Deployment the original write command ran against.
    deploymentId: string,
    /// Original operation command whose stored result and dispatch-time verification contract are authoritative.
    commandId: string,
}

class VerifyOperationCheckResponse {
    /// verified: success condition met. not-yet: keep polling. failed: the poll operation itself reported failure. skipped: the operation has no verification spec, or the write result carries none of the fields verification needs (the caller never opted in for this invocation).
    ///
    /// Known values: `verified`, `not-yet`, `failed`, `skipped`. Others may appear.
    outcome: string,
    /// Present for 'failed' and 'skipped'.
    reason: string?,
    /// The operation's declared retry policy, echoed so the caller's poll loop doesn't need its own copy.
    retry: OperationsPluginOperationRetries?,
    /// The operation's declared verification timeout.
    timeoutSeconds: int?,
}

/// A request to replace one replica's persistent volume with a volume made from a snapshot
class VolumeRestore {
