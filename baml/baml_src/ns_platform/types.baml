    createdBy: VolumeRestoreCreatedBy,
    createdAt: string,
    updatedAt: string,
    completedAt: string?,
    cancelledAt: string?,
}

/// Principal that requested the restore
class VolumeRestoreCreatedBy {
    /// User email when the principal is a user.
    email: string?,
    /// Stable user or service-account identifier.
    id: string,
    /// Type of authenticated principal that requested an event.
