/// Request schema for creating a new deployment
class NewDeploymentRequest {
    /// Deployment name.
    name: string,
    /// Target platform for the deployment
    ///
    /// Known values: `aws`, `gcp`, `azure`, `kubernetes`, `machines`, `local`, `test`. Others may appear.
    platform: string,
    /// Required for workspace/project tokens. Deployment group tokens use their own group automatically.
    deploymentGroupId: string?,
    /// Optional manager to assign. If omitted, the project default or system manager is selected.
    managerId: string?,
    /// ID of the pinned release
    pinnedReleaseId: string?,
    /// Configuration of environment variables for the deployment
    environmentVariables: EnvironmentVariableConfig[]?,
    /// Cloud environment information
    environmentInfo: (CommandDeploymentInfoEnvironmentInfoAws | CommandDeploymentInfoEnvironmentInfoGcp | CommandDeploymentInfoEnvironmentInfoAzure | CommandDeploymentInfoEnvironmentInfoLocal | CommandDeploymentInfoEnvironmentInfoTest | CommandDeploymentInfoEnvironmentInfoOther)?,
    /// Project ID or name
    project: string,
    /// External ID of a deployment group in the selected project. Supply this or deploymentGroupId, not both.
    deploymentGroupExternalId: string?,
    /// Base environment for a Kubernetes installation.
    ///
    /// Known values: `aws`, `gcp`, `azure`. Others may appear.
    basePlatform: string?,
    /// Stack settings for deployment customization
    stackSettings: StackSettings?,
    resourcePrefix: string?,
    /// Optional deployment subdomain under the project's generated-domain parent. Operator-only and requires a custom project domain; customer deploy-link tokens and the shared system domain are rejected. Omit to generate a random subdomain.
    publicSubdomain: string?,
    /// Setup method that created the deployment. Defaults to cli.
    setupMethod: string?,
    /// Setup method metadata used to guide privileged teardown.
    setupMetadata: DeploymentSetupMetadata?,
    /// Stack input values provided by the deployment creator.
    ///
    /// Default: `{}` (applied by the server when left out).
    inputValues: map<string, StackInputValueRequest>?,
    /// Display-only scope reported by the Operator manifest.
    operatorScope: string?,
    /// Display-only permission tier reported by the Operator manifest.
    operatorPermission: string?,
    /// Desired-release selection for a new deployment. Use none to register an environment without initially requesting a release; later updates can assign one.
    ///
    /// Known values: `active`, `none`. Others may appear.
    ///
    /// Default: `"active"` (applied by the server when left out).
    initialDesiredRelease: string?,
    /// Release channel followed while this deployment is not pinned.
    ///
    /// Default: `"production"` (applied by the server when left out).
    releaseChannel: string?,
    /// Customer setup item selected from this deployment-group token.
    ///
    /// Known values: `deployment`, `models`, `keys`, `bucket`, `registry`, `sandbox`. Others may appear.
    setupItem: string?,
    installation: DeploymentInstallationOptions?,
    /// Use await-registration to reserve a pending deployment before installing and registering its infrastructure.
    ///
    /// Known values: `immediate`, `await-registration`. Others may appear.
    ///
    /// Default: `"immediate"` (applied by the server when left out).
    setupHandoff: string?,

    @@json.omit_nulls
}

