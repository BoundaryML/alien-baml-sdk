    /// Known values: `aws`, `gcp`, `azure`, `kubernetes`, `machines`, `local`, `test`. Others may appear.
    platform: string,
    /// Known values: `aws`, `gcp`, `azure`. Others may appear.
    basePlatform: string?,
    /// Region or location reported by the setup artifact
    region: string,
    /// Setup target this package was generated for
    setupTarget: string,
    setupImportFormatVersion: int,
    /// Setup compatibility fingerprint embedded in the package
    setupFingerprint: string,
    /// Setup fingerprint algorithm version embedded in the package
    setupFingerprintVersion: int,
    /// User-customizable deployment settings specified at deploy time.
    ///
    /// These settings are provided by the customer via CloudFormation parameters,
    /// Terraform attributes, CLI flags, or Helm values. They customize how the
    /// deployment runs and what capabilities are enabled.
    ///
    /// **Key distinction**: StackSettings is user-customizable, while ManagementConfig
    /// is platform-derived (from the Manager's ServiceAccount).
    stackSettings: StackSettings,
    /// Management configuration for different cloud platforms.
    ///
    /// Platform-derived configuration for cross-account/cross-tenant access.
    /// This is NOT user-specified - it's derived from the Manager's ServiceAccount.
    managementConfig: (DeploymentConfigManagementConfigAws | DeploymentConfigManagementConfigGcp | DeploymentConfigManagementConfigAzure | DeploymentConfigManagementConfigKubernetes | DeploymentConfigManagementConfigOther)?,
    resources: ImportedResource[],

    @@json.omit_nulls
}

