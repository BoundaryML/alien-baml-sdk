    /// Known values: `pending`, `approved`, `declined`. Others may appear.
    accessStatus: string,
    /// Known values: `byoc`, `byok`, `byo-llm`, `byo-bucket`, `single-tenant`, `on-prem`, `private-networks`, `remote-ops`, `other`. Others may appear.
    useCaseTags: string[],
    /// What the user is hoping to use Alien for.
    useCases: string?,
    /// When the user completed the required profile setup dialog.
    profileSetupCompletedAt: string?,
    /// Version of the required profile setup dialog the user completed.
    profileSetupVersion: int?,
}

class UserProfileSetupRequest {
    /// Display name
    name: string,
    /// Company name
    company: string,
    /// How the user heard about Alien
    ///
    /// Known values: `github`, `x-twitter`, `linkedin`, `hacker-news`, `reddit`, `search`, `friend-or-colleague`, `founder`, `event-or-community`, `other`. Others may appear.
    acquisitionSource: string,
    /// Required when acquisitionSource is other
    acquisitionSourceDetail: string?,
    /// Known values: `byoc`, `byok`, `byo-llm`, `byo-bucket`, `single-tenant`, `on-prem`, `private-networks`, `remote-ops`, `other`. Others may appear.
    useCaseTags: string[]?,
    useCases: string?,

    @@json.omit_nulls
}

/// Authenticated user subject with workspace-scoped permissions
class UserSubject {
    /// Subject type identifier
    kind: "user",
    /// Unique user identifier
    id: string,
    /// User's email address
    email: string,
    /// ID of the workspace the user is authenticated within
