/// Request to acquire deployments for processing
class SyncAcquireRequest {
    /// Highest deployment protocol this runtime can interpret. Omitted means version 1.
    maxSupportedDeploymentProtocolVersion: int?,
    /// Manager requesting the deployments. If omitted, resolved from each deployment's managerId column.
    managerId: string?,
    /// Unique session identifier for lock tracking
    session: string,
    /// Idempotency key for one logical acquire request
    requestId: string,
    /// Specific deployment IDs to lock (for Pull model sync)
    deploymentIds: string[]?,
    /// Filter by deployment statuses (default: all deployment statuses)
    ///
    /// Known values: `pending`, `preflights-failed`, `initial-setup`, `initial-setup-failed`, `provisioning`, `waiting-for-machines`, `waiting-for-secrets`, `provisioning-failed`, `running`, `refresh-failed`, `update-pending`, `updating`, `update-failed`, `delete-pending`, `deleting`, `delete-failed`, `teardown-required`, `teardown-failed`, `retention-required`, `retained`, `deleted`, `error`. Others may appear.
    statuses: string[]?,
    /// Filter by platforms (default: all platforms the Manager supports)
    ///
    /// Known values: `aws`, `gcp`, `azure`, `kubernetes`, `machines`, `local`, `test`. Others may appear.
    platforms: string[]?,
    /// Filter by setup method for setup-owned acquisition paths
    setupMethod: string?,
    /// Phase ownership mode for deployment acquisition
    ///
    /// Known values: `runtime`, `setup-run`, `setup-teardown`. Others may appear.
    acquireMode: string?,
    /// Filter by deployment model from stackSettings.deploymentModel.
    ///
    /// Known values: `push`, `pull`. Others may appear.
    deploymentModel: string,
    /// Signals support for echoing executionClaim on renew, reconcile, and release.
    ///
    /// Known values: `true`. Others may appear.
    supportsExecutionClaims: bool?,
    /// Maximum number of deployments to acquire (default: 10)
    limit: int?,

    @@json.omit_nulls
}

