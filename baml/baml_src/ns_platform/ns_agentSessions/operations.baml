        client, "GET", `/v1/agent-sessions/${root.internal.path_segment(id)}`,
        query = { "workspace": client.workspace },
    )
}

/// List ai-agent monitor sessions for this workspace, or for one project. Newest first, capped at 50.
///
/// `GET /v1/agent-sessions` (operation `listAgentSessions`).
///
/// - `project`: Only sessions bound to this project. Omit to list the whole workspace.
function list(client: root.platform.PlatformClient, project: string? = null) -> root.platform.AgentSessionListResponse throws root.errors.AlienError {
    root.internal.platform_json<root.platform.AgentSessionListResponse>(
        client, "GET", "/v1/agent-sessions",
        query = { "workspace": client.workspace, "project": project },
    )
}

/// Stop (cancel) a running or queued ai-agent monitor session. Proxies to the ai-agent service, minting a fresh CLI session for the caller so the ai-agent's own auth applies. Idempotent — stopping an already-terminal session is a 200 no-op.
///
/// `POST /v1/agent-sessions/{id}/stop` (operation `stopAgentSession`).
function stop(client: root.platform.PlatformClient, id: string) -> root.platform.AgentSessionStopResponse throws root.errors.AlienError {
    root.internal.platform_json<root.platform.AgentSessionStopResponse>(
        client, "POST", `/v1/agent-sessions/${root.internal.path_segment(id)}/stop`,
        query = { "workspace": client.workspace },
    )
}
