/// Incrementally read a session's event log (steps, tool calls, report deltas, approvals, status transitions). Pass the previous response's `latestSeq` as `after` to fetch only new events.
///
/// `GET /v1/agent-sessions/{id}/events` (operation `listAgentSessionEvents`).
///
/// - `after`: Default: `0` (applied by the server when left out).
/// - `limit`: Default: `200` (applied by the server when left out).
function events(client: root.platform.PlatformClient, id: string, after: int? = null, limit: int? = null) -> root.platform.AgentSessionEventsResponse throws root.errors.AlienError {
    root.internal.platform_json<root.platform.AgentSessionEventsResponse>(
        client, "GET", `/v1/agent-sessions/${root.internal.path_segment(id)}/events`,
        query = { "workspace": client.workspace, "after": after, "limit": limit },
    )
}

/// Retrieve one ai-agent monitor session by id.
///
/// `GET /v1/agent-sessions/{id}` (operation `getAgentSession`).
function get(client: root.platform.PlatformClient, id: string) -> root.platform.AgentSessionDetail throws root.errors.AlienError {
