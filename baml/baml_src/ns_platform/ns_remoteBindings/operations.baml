/// Create short-lived Remote Bindings access for a external resource
///
/// Selects a connected external resource by Project and external ID, then returns a short-lived deployment-scoped Manager capability. The caller never receives the external cloud credentials from Platform.
///
/// `POST /v1/projects/{idOrName}/remote-bindings/access` (operation `createRemoteBindingsExternalAccess`).
///
/// - `idOrName`: Project ID or name.
function createExternalAccess(client: root.platform.PlatformClient, idOrName: string, body: root.platform.RemoteBindingsExternalAccessRequest) -> root.platform.RemoteBindingsExternalAccessResponse throws root.errors.AlienError {
    root.internal.platform_json<root.platform.RemoteBindingsExternalAccessResponse>(
        client, "POST", `/v1/projects/${root.internal.path_segment(idOrName)}/remote-bindings/access`,
        query = { "workspace": client.workspace },
        body = root.internal.json_body(body),
    )
}
