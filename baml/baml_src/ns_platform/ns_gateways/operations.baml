/// Get compact cross-Project setup and customer status for a workspace Gateway.
///
/// `GET /v1/gateways/{gateway}/overview` (operation `getWorkspaceGatewayOverview`).
///
/// - `gateway`: Alien Gateway a customer deployment runs
///
///   Known values: `ai`, `encryption`, `sandbox`. Others may appear.
function getWorkspaceOverview(client: root.platform.PlatformClient, gateway: string) -> root.platform.WorkspaceGatewayOverview throws root.errors.AlienError {
    root.internal.platform_json<root.platform.WorkspaceGatewayOverview>(
        client, "GET", `/v1/gateways/${root.internal.path_segment(gateway)}/overview`,
        query = { "workspace": client.workspace },
    )
}
