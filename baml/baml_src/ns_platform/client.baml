/// How to reach the Platform API.
class PlatformClient {
    /// Base URL, for example `https://api.alien.dev`. Trailing slashes are ignored; a
    /// query string stays at the end of each request URL.
    base_url: string,
    /// API key, sent as `Authorization: Bearer <api_key>`.
    api_key: string,
    /// Workspace name or ID, sent as the `workspace` query parameter on operations
