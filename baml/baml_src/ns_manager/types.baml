    cpu: string,
    deleted: bool,
    env: map<string, string>?,
    generation: int,
    healthCheck: DynamicContainerHealthCheck?,
    image: string,
    memory: string,
    name: string,
    ports: int[],
    replicas: int,
    secretEnv: map<string, string>?,
