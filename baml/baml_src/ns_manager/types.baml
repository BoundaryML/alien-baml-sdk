                        null => null,
                        let member: map<string, baml.json.json> => match (baml.json.to<string>(baml.json.field(member, "status"))) {
                            "success" => baml.json.to<CommandResponseSuccess>(member),
                            "error" => baml.json.to<CommandResponseError>(member),
                            _ => CommandResponseOther { status: "UNKNOWN", raw: member },
                        },
                        _ => throw baml.json.DecodeError { message: "expected a JSON object", path: "" },
                    },
                },
                _ => throw baml.json.DecodeError { message: "StorePayloadRequest must be a JSON object", path: "" },
            }
        }
    }

    implements baml.ToJson {
        function to_json(self) -> baml.json.json throws baml.json.SerializationError {
            let out: map<string, baml.json.json> = {};
            if (self.params != null) { out["params"] = baml.json.from(self.params); }
            if (self.response != null) { out["response"] = baml.json.from(self.response); }
            out
        }
    }
}

/// Request to submit a command response (from deployment)
type SubmitResponseRequest = CommandResponse

/// One release-independent container the Operator should run in its namespace.
/// The manager sends the complete set on every sync. An empty set removes
/// containers previously owned by this deployment.
class TargetDynamicContainer {
    cpu: string,
    deleted: bool,
    env: map<string, string>?,
    generation: int,
    healthCheck: DynamicContainerHealthCheck?,
    image: string,
    memory: string,
    name: string,
    ports: int[],
    replicas: int,
    secretEnv: map<string, string>?,
    /// Stop an installed workload when its release no longer admits the image.
    suspendedReason: string?,
}

/// Target operations-bundle set for the Operator to converge its loaded
/// plugin registry toward, independent of any release/config target — a
/// plugin can be enabled with no release change, so this is not nested under
/// `TargetDeployment`.
class TargetOperationsBundleSet {
    /// Presigned downloads for every bundle in the target set. The Operator
    /// fetches only the ones it doesn't already have loaded at the right
    /// version; already-loaded bundles are harmless to re-download.
    bundles: OperationsBundleDownload[]?,
    /// Hash identifying this exact enabled-plugin set. Compare against
    /// `OperationsReport.loadedBundleHash` to detect drift.
    hash: string,
}

class TokenResponse {
    createdAt: string,
    deploymentGroupId: string?,
    deploymentId: string?,
    id: string,
    keyPrefix: string,
    tokenType: string,
}

/// A downloadable build of a tool.
class ToolDownload {
    /// `<os>-<arch>`, e.g. `linux-x86_64`.
    platform: string,
    url: string,
}

/// W3C Trace Context propagated with a command lease.
///
/// The values are kept in their standard wire form so receivers can attach
/// them to handler telemetry without inventing separate trace/span fields.
class TraceContext {
    /// W3C `traceparent` header value.
    traceparent: string,
    /// Optional W3C `tracestate` header value.
    tracestate: string?,
}

/// Atomic outcome for one explicitly requested deployment that was not acquired.
class UnacquiredDeployment {
    deploymentId: string,
    /// Known values: `contended`, `deferred`, `statusMismatch`, `deploymentModelMismatch`, `platformMismatch`, `setupMethodMismatch`, `acquireModeMismatch`, `limitReached`. Others may appear.
    reason: string,
    retryAfter: string?,
}

/// Request to mark upload as complete
class UploadCompleteRequest {
    /// Size of uploaded data
    size: int,
}

/// Response to upload completion
class UploadCompleteResponse {
    /// Command identifier
    commandId: string,
    /// Updated command state
    ///
    /// Known values: `PENDING_UPLOAD`, `PENDING`, `DISPATCHED`, `SUCCEEDED`, `FAILED`, `EXPIRED`. Others may appear.
    state: string,
}

