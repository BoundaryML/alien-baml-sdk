/// Request body for manager-side stack import.
class StackImportRequest {
    /// Optional base cloud platform for Kubernetes setup targets such as
    /// EKS/GKE/AKS. The runtime platform remains Kubernetes.
    ///
    /// Known values: `aws`, `gcp`, `azure`, `kubernetes`, `machines`, `local`, `test`. Others may appear.
    basePlatform: string?,
    /// Deployment-group token authorizing the import.
    deploymentGroupToken: string,
    /// User-chosen deployment name. Must be unique within the deployment
    /// group; the manager returns 409 on collision rather than silently
    /// resolving to an existing deployment. Each setup adapter picks
    /// the natural source: CloudFormation defaults to the CFN stack name,
    /// Helm to `{namespace}/{release}`, Terraform requires an explicit
    /// `name` attribute on the `alien_deployment` resource.
    deploymentName: string,
    /// Deployer-provided stack input values collected by generated setup
    /// surfaces. Platform-backed managers resolve these into runtime
    /// environment variables before deployment creation; standalone managers
    /// accept the field for setup package compatibility.
    inputValues: map<string, json>?,
    /// Platform-derived management configuration, when this setup creates a
    /// cross-account/cross-tenant management identity.
    managementConfig: ManagementConfig?,
    /// Platform being imported.
    ///
    /// Known values: `aws`, `gcp`, `azure`, `kubernetes`, `machines`, `local`, `test`. Others may appear.
    platform: string,
    /// Region or location reported by the setup artifact.
    region: string,
    /// Optional release id that produced the setup package. When
    /// omitted, the manager imports against the latest release.
    releaseId: string?,
    /// Stable physical-name prefix used by the setup package for generated
    /// resources. Runtime controllers use it when addressing imported
    /// resources.
    resourcePrefix: string,
    /// Imported resources with typed per-resource payloads.
    resources: ImportedResource[],
    /// Setup compatibility fingerprint embedded in the package.
    setupFingerprint: string,
    /// Setup fingerprint algorithm version embedded in the package.
    setupFingerprintVersion: int,
    /// Wire-format version for the setup import payload.
    setupImportFormatVersion: int,
    /// Setup source metadata needed by the control plane to guide privileged
    /// teardown. The manager treats this as opaque JSON.
    setupMetadata: json?,
    /// Setup target this package was generated for.
    setupTarget: string,
    /// Optional source label for observability. Does not affect import
    /// behavior — the manager dispatches the same `ImporterRegistry`
    /// regardless of which setup package emitted the payload.
    ///
    /// Known values: `cloudformation`, `terraform`, `helm`. Others may appear.
    sourceKind: string?,
    /// Resolved stack settings supplied by the setup artifact.
    stackSettings: StackSettings,

    implements baml.FromJson {
        function from_json(j: baml.json.json) -> Self throws baml.json.DecodeError {
            match (j) {
                let object: map<string, baml.json.json> => StackImportRequest {
                    basePlatform: baml.json.to<string?>(baml.json.field(object, "basePlatform")),
                    deploymentGroupToken: baml.json.to<string>(baml.json.field(object, "deploymentGroupToken")),
                    deploymentName: baml.json.to<string>(baml.json.field(object, "deploymentName")),
                    inputValues: baml.json.to<map<string, json>?>(baml.json.field(object, "inputValues")),
                    managementConfig: match (baml.json.field(object, "managementConfig")) {
                        null => null,
                        let member: map<string, baml.json.json> => match (baml.json.to<string>(baml.json.field(member, "platform"))) {
                            "aws" => baml.json.to<ManagementConfigAws>(member),
                            "gcp" => baml.json.to<ManagementConfigGcp>(member),
                            "azure" => baml.json.to<ManagementConfigAzure>(member),
                            "kubernetes" => baml.json.to<ManagementConfigKubernetes>(member),
                            _ => ManagementConfigOther { platform: "UNKNOWN", raw: member },
                        },
                        _ => throw baml.json.DecodeError { message: "expected a JSON object", path: "" },
                    },
                    platform: baml.json.to<string>(baml.json.field(object, "platform")),
                    region: baml.json.to<string>(baml.json.field(object, "region")),
                    releaseId: baml.json.to<string?>(baml.json.field(object, "releaseId")),
                    resourcePrefix: baml.json.to<string>(baml.json.field(object, "resourcePrefix")),
                    resources: baml.json.to<ImportedResource[]>(baml.json.field(object, "resources")),
                    setupFingerprint: baml.json.to<string>(baml.json.field(object, "setupFingerprint")),
                    setupFingerprintVersion: baml.json.to<int>(baml.json.field(object, "setupFingerprintVersion")),
                    setupImportFormatVersion: baml.json.to<int>(baml.json.field(object, "setupImportFormatVersion")),
                    setupMetadata: baml.json.to<json?>(baml.json.field(object, "setupMetadata")),
                    setupTarget: baml.json.to<string>(baml.json.field(object, "setupTarget")),
                    sourceKind: baml.json.to<string?>(baml.json.field(object, "sourceKind")),
                    stackSettings: baml.json.to<StackSettings>(baml.json.field(object, "stackSettings")),
                },
                _ => throw baml.json.DecodeError { message: "StackImportRequest must be a JSON object", path: "" },
            }
        }
    }

    implements baml.ToJson {
        function to_json(self) -> baml.json.json throws baml.json.SerializationError {
            let out: map<string, baml.json.json> = {};
