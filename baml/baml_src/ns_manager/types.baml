}

/// Represents the state of a single resource within the stack for a specific platform.
class StackResourceState {
    /// The platform-specific resource controller that manages this resource's lifecycle.
    /// This is None when the resource status is Pending.
    /// Stored as JSON to make the struct serializable and movable to alien-core.
    ///
    /// Wire name: `_internal`.
    internal: json? @json.rename("_internal"),
    /// The current resource configuration.
    config: BaseResource,
    /// Platform whose controller owns this resource state. Defaults to the
    /// containing stack platform when absent.
    ///
    /// Known values: `aws`, `gcp`, `azure`, `kubernetes`, `machines`, `local`, `test`. Others may appear.
    controllerPlatform: string?,
    /// Complete list of dependencies for this resource, including infrastructure dependencies.
    /// This preserves the full dependency information from the stack definition.
    dependencies: ResourceRef[]?,
    description: string?,
    /// Presentation metadata from the effective resource entry, outside runtime configuration.
    displayName: string?,
    /// Stores the last error encountered during a failed step transition.
    error: AlienError?,
    /// Stores the controller state that failed, used for manual retry operations.
    /// This allows resuming from the exact point where the failure occurred.
    /// Stored as JSON to make the struct serializable and movable to alien-core.
    lastFailedState: json?,
    /// The lifecycle of the resource (Frozen or Live).
    /// Defaults to Live if not specified.
    ///
    /// Known values: `frozen`, `live`. Others may appear.
    lifecycle: string?,
    /// Outputs generated by the resource (e.g., ARN, URL, Bucket Name).
    outputs: BaseResourceOutputs?,
    /// The previous resource configuration during updates.
    /// This is set when an update is initiated and cleared when the update completes or fails.
    previousConfig: BaseResource?,
    /// Last reported step explanation for display only; not a machine-readable status.
    progress: string?,
    /// Binding parameters for remote access.
    /// Only populated when the resource has `remote_access: true` in its ResourceEntry.
    /// This is the JSON serialization of the binding configuration (e.g., StorageBinding, VaultBinding).
    /// Populated by controllers during provisioning using get_binding_params().
    remoteBindingParams: json?,
    /// Tracks consecutive retry attempts for the current state transition.
    retryAttempt: int?,
    /// High-level status derived from the internal state.
    ///
    /// Known values: `pending`, `provisioning`, `provision-failed`, `running`, `updating`, `update-failed`, `deleting`, `delete-failed`, `teardown-required`, `deleted`, `refresh-failed`. Others may appear.
    status: string,
    /// The high-level type of the resource (e.g., Worker::RESOURCE_TYPE, Storage::RESOURCE_TYPE).
    type: string,

    @@json.omit_nulls
}

/// User-customizable deployment settings specified at deploy time.
///
/// These settings are provided by the customer via CloudFormation parameters,
/// Terraform attributes, CLI flags, or Helm values. They customize how the
/// deployment runs and what capabilities are enabled.
///
/// **Key distinction**: StackSettings is user-customizable, while ManagementConfig
/// is platform-derived (from the Manager's ServiceAccount).
class StackSettings {
    /// Deployment-time compute selections for Alien-managed compute pools.
    ///
    /// This is where provider machine names such as EC2 instance types, GCE
    /// machine types, or Azure VM SKUs belong. Application source should
    /// declare portable requirements instead.
    compute: ComputeSettings?,
    /// Deployment model: push (Manager) or pull (Agent).
    /// Default: Push.
    /// - Push: Manager drives updates. For cloud platforms, requires cross-account
    ///   credentials established during initial setup. For push-mode local
    ///   deployments (currently `alien dev`), the manager has direct access —
    ///   no bootstrap needed.
    /// - Pull: Agent in the target environment drives updates via polling.
    ///   Required for Kubernetes and remote local deployments.
    ///
    /// Known values: `push`, `pull`. Others may appear.
    deploymentModel: string?,
    /// Domain configuration (future).
    domains: DomainSettings?,
    /// Who can reach public endpoints. Private access requires AWS managed containers.
    /// This choice cannot change after setup; create a new deployment to change it.
    ///
    /// Known values: `internet`, `private`. Others may appear.
    endpointAccess: string?,
    /// External bindings for pre-existing infrastructure.
    /// Allows using existing resources (MinIO, Redis, shared Container Apps
    /// Environment, etc.) instead of having Alien provision them.
    /// Required for Kubernetes platform, optional for cloud platforms.
    externalBindings: ExternalBindings?,
    /// How heartbeat health checks are handled.
    /// - off: No heartbeat permissions
    /// - on: Heartbeat enabled (default)
    ///
    /// Known values: `off`, `on`. Others may appear.
    heartbeats: string?,
    /// Kubernetes runtime substrate configuration.
    kubernetes: KubernetesSettings?,
    /// Network configuration for the stack (VPC/VNet settings).
    /// If `None`, an isolated VPC with NAT is auto-created when the stack has resources
    /// that require networking (e.g., containers). Set explicitly to customize:
    /// `UseDefault` for the provider's default network (fast, dev/test only),
    /// `Create` for an isolated VPC with managed NAT (production), or `ByoVpc*`
    /// to reference an existing customer-managed VPC.
    network: NetworkSettings?,
    /// Exact externally managed endpoint URLs, keyed by resource ID and endpoint name.
    ///
    /// This is intended for adopted Machines deployments whose DNS and certificates remain
    /// customer-owned. The platform passes these URLs to the runtime without creating or
    /// replacing DNS records or certificates.
    publicEndpoints: map<string, map<string, string>>?,
    /// Provider quota identities whose preflight failures become visible warnings
    /// for this deployment. Checks still run; deploy-time provider limits still apply.
    /// Unknown identities are rejected. An empty list restores normal blocking.
    quotaWarningOverrides: string[]?,
    /// Ongoing authority over infrastructure normally owned by setup. Automatic requires
    /// an explicit CLI setup grant; changing this setting alone never grants that authority.
    ///
    /// Known values: `manual`, `automatic`. Others may appear.
    setupManagement: string?,
    /// How telemetry (logs, metrics, traces) is handled.
    /// - off: No telemetry permissions
    /// - auto: Telemetry flows automatically (default)
    /// - approval-required: Telemetry waits for explicit approval
    ///
    /// Known values: `off`, `auto`, `approval-required`. Others may appear.
    telemetry: string?,
    /// How updates are delivered.
    /// - auto: Updates deploy automatically (default)
    /// - approval-required: Updates wait for explicit approval
    ///
    /// Known values: `auto`, `approval-required`. Others may appear.
    updates: string?,

    @@json.omit_nulls
}

/// Represents the collective state of all resources in a stack, including platform and pending actions.
class StackState {
    /// The target platform for this stack state.
    ///
    /// Known values: `aws`, `gcp`, `azure`, `kubernetes`, `machines`, `local`, `test`. Others may appear.
    platform: string,
    /// A prefix used for resource naming to ensure uniqueness across deployments.
    resourcePrefix: string,
    /// The state of individual resources, keyed by resource ID.
    resources: map<string, StackResourceState>,
}

